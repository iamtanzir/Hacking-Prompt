{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["redteam/**/*.mjs", "blue/**/*.mjs", "teams/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "redteam/results*", "results"]
}
